{
  "name": "my-haiku-chat",
  "compatibility_date": "2026-10-10",
  "main": "worker/index.js",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*"]
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CHAT_RATE_LIMIT",
        "class_name": "ChatRateLimit"
      },
      {
        "name": "PROMPT_CANVAS",
        "class_name": "PromptCanvas"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "ChatRateLimit",
        "PromptCanvas"
      ]
    }
  ]
}
